# URL do Backend API (que fala com o Neon). Em dev pode ser /api via proxy.
VITE_API_URL=/api

# Neon Auth (Stack Auth) — chaves públicas do frontend
VITE_STACK_PROJECT_ID=
VITE_STACK_PUBLISHABLE_CLIENT_KEY=

# Contato público da landing.
# WhatsApp no formato internacional só com dígitos: 55 + DDD + número.
# Ex.: VITE_WHATSAPP_NUMBER=5571999998888
# Se ficar vazio, os botões "Falar com Consultor" caem para o e-mail e o
# botão flutuante do WhatsApp não é exibido.
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=geste.escolar@gmail.com

# Analytics de conversão. Sem ID preenchido nenhum script é carregado.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
